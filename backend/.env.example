# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace the values with your local settings.
# Never commit your actual .env file to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=sweet_shop_delivery
DB_CONNECTION_LIMIT=10

# JWT Security Secrets (Use long, cryptographically random strings)
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_for_access_token_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_long_random_secret_for_refresh_token_at_least_32_chars

# Token Expiry Durations
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated URLs for production frontend)
CORS_ALLOWED_ORIGINS=https://mithaimahal.com,https://www.mithaimahal.com

# Payment Gateway Configuration
# Options: 'razorpay' (Production / Staging) or 'mock' (Local Development Only)
PAYMENT_PROVIDER=mock
PLATFORM_COMMISSION_PERCENT=10.0

# Razorpay Credentials (Keep strictly on server; never expose in frontend)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook Verification Secret (From Razorpay Merchant Dashboard -> Webhooks)
PAYMENT_WEBHOOK_SECRET=your_configured_webhook_secret_here
